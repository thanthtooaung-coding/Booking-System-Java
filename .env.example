# Copy to .env and fill in values. Spring reads these when exported to the environment (shell, IDE, or docker --env-file).

# PostgreSQL (create database first, e.g. booking_system)
SPRING_DATABASE_URL=jdbc:postgresql://localhost:5432/booking_system
SPRING_DATABASE_USERNAME=postgres
SPRING_DATABASE_PASSWORD=

# JWT signing secret — use a long random string in production
JWT_SECRET=

# Redis — match docker-compose.yml if using: password mypassword on localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mypassword

# Optional overrides
# CACHE_TTL_MS=3600000
# CRUD_CACHE_ENABLED=true
